# FROM: Sets the base image for the Docker image.
# In this case, it uses the official Python 3.15 Alpine image.
# It is a lightweight version of Python.
FROM python:3.15-alpine

# RUN: Updates the package list and installs the build dependencies.
RUN pip install --no-cache-dir flake8

# WORKDIR: Sets the working directory inside the Docker image to /code.
WORKDIR /code